# Use this only for a direct reverse-proxy setup.
# If you are using Cloudflare Tunnel, keep router 80/443 closed unless you explicitly need them.
your-domain.example {
  encode gzip zstd

  reverse_proxy 127.0.0.1:3000 {
    transport http {
      read_timeout 600s
      write_timeout 600s
      dial_timeout 10s
    }
  }
}
